# Every text file in this repo is LF, whatever the machine editing it does.
* text=auto eol=lf

# The sample files are the point: not one byte of them is ours to normalise.
web/public/samples/** -text

# Batch files are read by cmd.exe, which wants CRLF: a label or a parenthesised
# block with LF endings can be misparsed.
*.bat text eol=crlf
