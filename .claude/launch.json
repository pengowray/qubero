{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 17272,
      "autoPort": true
    },
    {
      "name": "web-local",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:QUBERO_FILES='D:/'; npm run dev"
      ],
      "cwd": "web",
      "port": 17273,
      "autoPort": true
    },
    {
      "name": "web-samples",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:QUBERO_FILES='C:/Users/pengo/Dropbox/projects/qubero-samples'; npm run dev"
      ],
      "cwd": "web",
      "port": 17274,
      "autoPort": true
    }
  ]
}