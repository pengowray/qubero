{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-local",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:QUBERO_FILES='D:/'; $env:PORT='17273'; npm run dev"
      ],
      "cwd": "web",
      "port": 17273,
      "autoPort": true
    }
  ]
}
