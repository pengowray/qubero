{
  "name": "qubero-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "npm run wasm:core && npm run wasm:magic",
    "wasm:core": "cd ../crates/wasm && wasm-pack build --target web --out-dir ../../web/src/pkg --release",
    "wasm:magic": "cd ../crates/magic && wasm-pack build --target web --out-dir ../../web/src/pkg-magic --release"
  },
  "devDependencies": {
    "typescript": "^5.9",
    "vite": "^7"
  }
}
